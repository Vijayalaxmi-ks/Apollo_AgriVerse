# Python and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
myenv/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*service-account*.json

# Notebooks, test output and generated files
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
pip-wheel-metadata/
.cache/

# Local logs and temporary output
logs/*
!logs/.gitkeep
temp/*
!temp/.gitkeep
*.log

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
# Ignore everything inside 02_Datasets by default
02_Datasets/*

# Whitelist specific subfolders
!02_Datasets/KnowledgeBase/
!02_Datasets/KnowledgeBase/*.csv

!02_Datasets/Synthetic/generators/
!02_Datasets/Synthetic/generators/*.py
!02_Datasets/Master/
!02_Datasets/Master/*.ipynb
!02_Datasets/Processed/Grapes/
!02_Datasets/Processed/Grapes/*.csv